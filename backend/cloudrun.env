# ==============================================================================
# Google Cloud Run 部署規格設定檔 (Digital Garage API)
# ==============================================================================
# 本檔案由使用者明確授權規範。日後每次進行 Cloud Run 部署或更新時，
# 必須嚴格讀取本檔案之參數，不得任意提高資源規格，確保營運成本受控。
# ==============================================================================

# 服務名稱與部署區域 (us-central1 與 Supabase 同區，零跨區網路流量費)
SERVICE_NAME=digital-garage-api
REGION=us-central1

# 資源限制規格 (嚴格限制)
# - CPU: 1
# - RAM: 256MB (256Mi)
CPU=1
MEMORY=256Mi

# 執行個體縮放限制 (Autoscaling)
# - 執行個體數量下限: 0 (無請求時縮容至 0，達成零運算成本)
# - 執行個體數量上限: 2 (最大 2 個實例，嚴防異常高流量導致費用失控)
MIN_INSTANCES=0
MAX_INSTANCES=2

# 連線與逾時設定
CONCURRENCY=80
TIMEOUT=300s
ALLOW_UNAUTHENTICATED=true
